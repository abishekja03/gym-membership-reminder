      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "Gym Membership Expiry Remainder",
        "message": "=={{ `\n<h2>Hello ${$json.Name}!</h2>\n\n<p>This is a reminder that your gym membership is expiring soon.</p>\n\n<p><b>Member Name:</b> ${$json.Name}</p>\n\n<p><b>Membership Plan:</b> ${$json.Membership_plan}</p>\n\n<p><b>Expiry Date:</b> ${$json.Expiry_date}</p>\n\n<p><b>Days Remaining:</b> ${$json.days_until_expiry}</p>\n\n<p>Please renew your membership to continue enjoying our gym facilities.</p>\n\n<p>Thank you!</p>\n\n<p>Gym Management Team</p>\n` }}",
        "options": {}
      },
